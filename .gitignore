# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# real publisher pages used for local parser tests (not redistributed)
/test/fixtures/real/

# Chrome Web Store upload bundle (npm run ext:zip)
/cucinaloca-extension.zip

# Eval output: keep results, leave out bulky and derived files
.claude/hillclimb/**/traces/
.claude/hillclimb/**/report.html
.claude/hillclimb/**/state.json
.claude/hillclimb/**/trajectory/
.claude/hillclimb/chat/ci/
