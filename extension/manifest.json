{
  "manifest_version": 3,
  "name": "Cucina Loca",
  "version": "0.1.0",
  "description": "Open the recipe you're on in a clean side panel, then tweak it to fit your kitchen.",
  "homepage_url": "https://cucinaloca.com",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Cook this recipe",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "activeTab", "scripting", "storage"],
  "minimum_chrome_version": "116"
}
